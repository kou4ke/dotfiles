echo "include zsh functions"

function clean_docker_container() {
  docker ps -a |grep $1|awk -F' ' '{print $1}'|xargs docker rm
}

function d() {
  case "$1";in
    "s")
      open -a Docker
      ;;
    "p")
      docker ps
      ;;
    "pa")
      docker ps -a
      ;;
    "i")
      docker images
      ;;
    "a")
      docker attach
      ;;
    "ip")
      docker image prune
      ;;
    "cp")
      docker container prune
      ;;
    "ish")
      docker run -it $2 /bin/bash
      ;;
    "csh")
      docker exec -it $2 /bin/bash
      ;;
    "e")
      docker exec $2 $3
      ;;
  esac
}

function dc() {
  case "$1";in
    "u") docker compose up -d
      ;;
    "ub") docker compose up --build --watch
      ;;
    "uw") docker compose up --watch
      ;;
    "c") docker compose up --no-start $2
      ;;
    "s") docker compose start $2
      ;;
    "r") docker compose restart $2
      ;;
    "d") docker compose down
      ;;
    "b") docker compose build
      ;;
    "sh") docker compose exec $2 /bin/bash
      ;;
    "e") docker compose exec $2 $3
      ;;
    *) echo "option ${@}"
      docker compose "$@"
      ;;
  esac
}

function ec2list() {
  if [ $# -eq 1 ];
  then
    aws ec2 describe-instances | jq --arg search_word $1 '.Reservations[].Instances[] | select(.Tags[].Value | contains($search_word)) | {InstanceId, InstanceName: (.Tags[] | select(.Key=="Name").Value),  PrivateIpAddress, State: (.State.Name)}'
  else
    aws ec2 describe-instances | jq '.Reservations[].Instances[] | {InstanceId, InstanceName: (.Tags[] | select(.Key=="Name").Value),  PrivateIpAddress, State: (.State.Name)}'
  fi
}

function ec2desc() {
  if [ $# -eq 1 ];
  then
    aws ec2 describe-instances | jq --arg search_word $1 '.Reservations[].Instances[] | select(.Tags[].Value | contains($search_word))'
  else
  fi
}

function hs() {
  ag $1 -A 1 ~/.ssh/*
}

function fzf-src () {
  local lines=()
  # ghqリポジトリ一覧 + worktree一覧をlinesに格納
  for repo in $(ghq list -p); do
    lines+=("$repo")
    if [ -d "$repo" ]; then
      # worktreeがあれば抽出
      git -C "$repo" worktree list --porcelain | awk '/^worktree /{print $2}' | while read wt; do
        # ghq root配下なら相対パス表示も
        if [[ $wt != "$repo" ]]; then
          lines+=("$wt")
        fi
      done
    fi
  done

  # fzf実行
  local selected_dir=$(printf "%s\n" "${lines[@]}" | fzf --reverse --query "$LBUFFER")
  if [ -n "$selected_dir" ]; then
    BUFFER="cd ${selected_dir}"
    zle accept-line
  fi
  zle clear-screen
}
zle -N fzf-src
bindkey '^]' fzf-src


function _fzf_get_ls_item () {
  local fzf_ls_item=$(ls -la | fzf --query "$LBUFFER" | awk '{print $(NF)}')
  echo $fzf_ls_item
  return fzf_ls_item
}

function fzf-vim () {
  local selected_item=$(_fzf_get_ls_item)
  if [ -n "$selected_item" ]; then
    if [ -d $selected_item ]; then
      cd ${selected_item}
      fzf-vim
    elif [ -f $selected_item ]; then
      BUFFER="vim ${selected_item}"
      zle accept-line
    fi
  fi
  zle clear-screen
}
zle -N fzf-vim
bindkey '^v' fzf-vim

function fzf-history() {
  local tac

  if which tac > /dev/null; then
    tac="tac"
  else
    tac="tail -r"
  fi

  BUFFER=$(history -n 1 | eval $tac | fzf --reverse --no-sort --query "$LBUFFER")
  CURSOR=$#BUFFER

  zle reset-prompt
}

# 定義: clean-branchスクリプト
function clean-branch() {
  # 現在のブランチ名を取得
  current_branch=$(git branch --show-current)

  # 通常のマージ済みブランチ（fast-forward/merge）の削除
  git branch --merged | egrep -v '\*|master|main|development|dev|release' | xargs -r git branch -d

  # squash mergeやrebase等で内容が取り込まれているブランチのチェックと削除
  for branch in $(git branch | sed 's/..//' | egrep -v '^(master|main|development|dev|release)$' | grep -v "^$current_branch$"); do
    # すでに消えていればスキップ
    git show-ref --verify --quiet refs/heads/$branch || continue
    # cherryで全コミットが取り込まれている場合（+がなければOK）
    if [ -z "$(git cherry $current_branch $branch | grep '^+')" ]; then
      echo "Deleting branch $branch (fully merged by squash/rebase/merge)"
      git branch -D $branch
    else
      echo "Skipping branch $branch (unmerged commits remain)"
    fi
  done
}

zle -N fzf-history
bindkey '^r' fzf-history

function op-stg () {
  env AWS_DEFAULT_PROFILE=openpage_stg make run_ecs_shell ENV=staging
}

function op-prod () {
  env AWS_DEFAULT_PROFILE=openpage_prod make run_ecs_shell ENV=production
}

function op-pf-stg () {
  env AWS_DEFAULT_PROFILE=openpage_stg make forward_rds ENV=staging
}

function op-pf-prod () {
  env AWS_DEFAULT_PROFILE=openpage_prod make forward_rds ENV=production
}

function ap-stg () {
  export AWS_PROFILE=openpage_stg
}

function ap-prod () {
  export AWS_PROFILE=openpage_prod
}

function ap-sec () {
  export AWS_PROFILE=openpage_security
}

function ap-default () {
  unset AWS_PROFILE
}

